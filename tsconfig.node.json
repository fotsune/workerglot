{
  // The Node entry point (server.ts) reuses the Worker's fetch handler, so it is
  // type-checked with the same sources but against Node's globals instead of workerd's.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["server.ts", "worker.ts", "translation.ts", "config.ts", "providers/**/*.ts"]
}
